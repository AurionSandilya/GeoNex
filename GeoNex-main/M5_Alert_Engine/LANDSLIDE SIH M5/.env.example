# =============================================================================
# M5 Alert Engine - Environment Configuration
# NER-LEWS SIH 2026 Integration
# =============================================================================
# M5 listens on port 8001 (M3 runs on 8000).
# Both services share the SAME PostgreSQL database (sih_landslide).
# M5 owns: alerts, alert_deliveries, alert_config, notification_intents tables.
# M3 owns: all other tables. M5 reads risk_predictions via SELECT only.

# ----- Database (SHARED with M3 — same PostgreSQL instance & DB) -----
DATABASE_URL=postgresql+asyncpg://postgres:sih2026postgis@localhost:5432/sih_landslide

# ----- Service-to-Service Auth (must match M3 .env values) -----
M3_SERVICE_KEY=m3-m5-internal-shared-key
M5_SERVICE_KEY=m3-m5-internal-shared-key

# ----- M3 Integration (M5 calls back to M3 for recipient resolution) -----
M3_BASE_URL=http://localhost:8000
M3_HTTP_TIMEOUT_SECONDS=10.0

# ----- Dev/Test: allow skipping service-key auth when key not set -----
ALLOW_INSECURE_NO_SERVICE_KEY=true

# ----- Scheduler -----
ENABLE_SCHEDULER=true
ENABLE_DISPATCHER=true
DISPATCH_LOOP_INTERVAL_SECONDS=15

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT_JSON=false
ENVIRONMENT=development

# ----- Optional: SMS / FCM notifications (leave blank for dev) -----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FCM_SERVER_KEY=
